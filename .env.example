# ── LLM provider ──────────────────────────────────────────────────────
# "groq" (default, free tier), "deepseek", or "openai".
# LLM_PROVIDER=groq

# Groq — free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=openai/gpt-oss-120b        # alternatives: openai/gpt-oss-20b, qwen/qwen3.8-27b

# DeepSeek — paid, no free tier. https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-your_key_here
# DEEPSEEK_MODEL=deepseek-v4-flash      # alternative: deepseek-v4-pro

# OpenAI — used only when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your_key_here
# OPENAI_MODEL=gpt-4o-mini

# ── Optional overrides (defaults shown) ───────────────────────────────
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=600
# CHUNK_OVERLAP=80
# RETRIEVER_TOP_K=4
# SQL_MAX_ROWS=20
# MAX_STAY_DAYS=365

# Path to the raw Kaggle CSV, if you keep it somewhere else.
# RAW_CSV_PATH=healthcare_dataset.csv

# ── Servers ───────────────────────────────────────────────────────────
# API_HOST=127.0.0.1
# API_PORT=8010
# GRADIO_SERVER_PORT=7860
